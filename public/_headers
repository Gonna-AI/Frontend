# Response headers for every deploy. Single source: netlify.toml defines none.
# scripts/csp.mjs fills in the placeholders at build time: the hashes of the inline
# scripts in the built HTML (so script-src needs no 'unsafe-inline') and the backend
# origin this build was configured with (VITE_SUPABASE_URL).

/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self' {{INLINE_SCRIPT_HASHES}}; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' {{SUPABASE_ORIGINS}} https://*.clerktree.com https://*.amplitude.com https://cdn.jsdelivr.net; worker-src 'self' blob:; frame-src 'self' https://www.google.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# Fingerprinted build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Machine-readable files: short cache, so a new deploy reaches crawlers within minutes.
/version.json
  Cache-Control: no-store

/llms.txt
  Cache-Control: public, max-age=300, must-revalidate
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Cache-Control: public, max-age=300, must-revalidate
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=300, must-revalidate

/feed.xml
  Cache-Control: public, max-age=300, must-revalidate

/robots.txt
  Cache-Control: public, max-age=300, must-revalidate

# Signed-in and sign-in pages are not for search engines. Said here, per response,
# rather than listed in robots.txt where anyone can read the route names.
/dashboard
  X-Robots-Tag: noindex, nofollow
/dashboard/*
  X-Robots-Tag: noindex, nofollow
/login
  X-Robots-Tag: noindex, nofollow
/auth/*
  X-Robots-Tag: noindex, nofollow
/client
  X-Robots-Tag: noindex, nofollow
/client/*
  X-Robots-Tag: noindex, nofollow
/invite
  X-Robots-Tag: noindex, nofollow
/mail
  X-Robots-Tag: noindex, nofollow
/chat
  X-Robots-Tag: noindex, nofollow

/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.mp4
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
