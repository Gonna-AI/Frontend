{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ClerkTree brand tokens. Source of truth for colour, type and radius on clerktree.com. Logo files live next to this file under /brand/.",
  "color": {
    "$type": "color",
    "black": { "$value": "#000000", "$description": "Hero stages and full-bleed dark surfaces." },
    "logo": { "$value": "#060606", "$description": "Logo artwork on light backgrounds." },
    "ink": { "$value": "#0A0A0A", "$description": "Headings and primary text." },
    "muted": { "$value": "#555555", "$description": "Body copy and secondary text." },
    "border": { "$value": "#C8C8C8", "$description": "Hairlines and dividers on the canvas." },
    "canvas": { "$value": "#F4F4F4", "$description": "Page background." },
    "sunken": { "$value": "#EDEDED", "$description": "Inputs and inset wells." },
    "surface": { "$value": "#FFFFFF", "$description": "Cards, panels and the header shell." },
    "panel": { "$value": "#FFFFFF", "$description": "Alias of surface." },
    "white": { "$value": "#FFFFFF", "$description": "Inverse logo and text on dark." },
    "signal": { "$value": "#FF4D00", "$description": "Accent only: emphasis, highlights, live states. Never on the logo." }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Cal Sans", "Inter", "system-ui", "sans-serif"] },
    "text": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.display}", "fontWeight": 400, "fontSize": "88px", "lineHeight": "84px", "letterSpacing": "-0.03em" } },
    "page-heading": { "$value": { "fontFamily": "{font.display}", "fontWeight": 400, "fontSize": "56px", "lineHeight": "58px", "letterSpacing": "-0.02em" } },
    "section-heading": { "$value": { "fontFamily": "{font.display}", "fontWeight": 400, "fontSize": "36px", "lineHeight": "40px", "letterSpacing": "-0.015em" } },
    "subheading": { "$value": { "fontFamily": "{font.display}", "fontWeight": 400, "fontSize": "22px", "lineHeight": "28px", "letterSpacing": "-0.01em" } },
    "intro": { "$value": { "fontFamily": "{font.text}", "fontWeight": 400, "fontSize": "18px", "lineHeight": "30px", "letterSpacing": "0" } },
    "body": { "$value": { "fontFamily": "{font.text}", "fontWeight": 400, "fontSize": "16px", "lineHeight": "26px", "letterSpacing": "0" } },
    "metadata": { "$value": { "fontFamily": "{font.text}", "fontWeight": 400, "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "0" } },
    "eyebrow": { "$value": { "fontFamily": "{font.text}", "fontWeight": 500, "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0.08em" } }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Concentric: shell = stage + shell padding. Desktop values; phones use stage 22, padding 12, card 20.",
    "pill": { "$value": "999px" },
    "control": { "$value": "14px" },
    "card": { "$value": "24px" },
    "stage": { "$value": "34px" },
    "shellPadding": { "$value": "20px" },
    "shell": { "$value": "54px" }
  },
  "logo": {
    "clearSpace": { "$value": "1X", "$description": "X = half the height of the mark. Keep 1X clear on every side." },
    "minWidth": {
      "lockup": { "$type": "dimension", "$value": "120px" },
      "mark": { "$type": "dimension", "$value": "24px" }
    }
  }
}
