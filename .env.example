# ClerkTree frontend environment.
# Copy to .env and fill in. Never commit .env.
#
# Everything prefixed VITE_ is compiled into the public JavaScript bundle and is
# visible to every visitor. Only put values here that are safe to publish.
# Secrets (provider API keys, service-role keys) belong in Supabase Edge
# Function secrets or the backend's environment, never in a VITE_ variable.

# --- Required -------------------------------------------------------------

# Supabase project (public URL and anon key; data access is enforced by RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Optional -------------------------------------------------------------

# Amplitude browser key (public). Analytics only runs after visitor consent.
# VITE_AMPLITUDE_API_KEY=

# Image host. Attach a custom domain to the R2 bucket and set it here so images
# are served through the CDN (the default r2.dev address is rate-limited, uncached).
# VITE_MEDIA_BASE_URL=https://media.clerktree.com

# --- Tooling only (not used by the built site) ------------------------------

# scripts/r2-upload.mjs (npm run r2:upload): Cloudflare R2 media uploads
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-r2-api-token
R2_BUCKET_NAME=clerktree-media
# R2_SIZE_CAP_BYTES=10200547328
